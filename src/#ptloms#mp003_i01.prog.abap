*&---------------------------------------------------------------------*
*&      Module  USER_COMMAND_0100  INPUT
*&---------------------------------------------------------------------*
MODULE user_command_0100 INPUT.

  IF sy-ucomm = 'EXIT' OR
     sy-ucomm = 'BACK' OR
     sy-ucomm = 'CANC'.

    LEAVE TO SCREEN 0.

  ELSEIF sy-ucomm = 'ELI_USUARIO'.

    PERFORM f_valida_associacao.

  ENDIF.
ENDMODULE.
